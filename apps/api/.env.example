# Safe template only: NO REAL CREDENTIALS IN GIT
# Copy to apps/api/.env, insert the Neon DEVELOPMENT connection string there.
# Choose development branch/database and role in the Neon Console > Connect.
# Keep sslmode=require and channel_binding=require from Neon.
DATABASE_URL="postgresql://YOUR_DEV_ROLE:YOUR_DEV_PASSWORD@ep-YOUR-DEV-ENDPOINT.us-east-2.aws.neon.tech/YOUR_DEV_DB?sslmode=require&channel_binding=require"
