{
  "name": "@smartpos/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "SmartPOS Electron React desktop demo with durable local SQLite v1 schema (no checkout yet)",
  "type": "commonjs",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "security:check": "node scripts/security-check.mjs",
    "test:local-db": "node --experimental-strip-types --test tests/local-db.test.mjs",
    "test:catalog-cache": "node --experimental-strip-types --test tests/catalog-cache.test.mjs",
    "test:offline-sale": "node --experimental-strip-types --test tests/offline-sale.test.mjs",
    "test:offline-sale:wire": "pnpm --filter @smartpos/contracts exec tsx --test ../../apps/desktop/tests/offline-sale-wire.test.ts",
    "test:receipt-db": "pnpm --filter @smartpos/domain exec tsx --test ../../apps/desktop/tests/receipt-db.test.ts",
    "test:receipt-boundary": "node --test tests/receipt-boundary.test.mjs"
  },
  "dependencies": {
    "@smartpos/domain": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "44.9.3",
    "electron-vite": "6.0.0",
    "vite": "8.3.5"
  }
}
